# ==============================================================================
# RESQFLOW AI — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Never commit real secrets to version control. Configure secrets via AI Studio
# Settings > Secrets or your cloud deployment secret manager.

# --- SERVER-SIDE PRIVATE CREDENTIALS (NEVER EXPOSE TO BROWSER) ---

# Required for Gemini AI Orchestration, Agents, Grounding, Vision, Audio, Video, Music
# Obtain from Google AI Studio > Settings > Secrets
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: Google Maps Platform server-side key for Routes API v2 & Geocoding proxy (Geocoding API, Routes API)
# Never reuse browser keys on server or expose this key to client; falls back to OpenStreetMap OSRM/Nominatim if unset
GOOGLE_MAPS_API_KEY=""

# Optional: OpenWeather API key (system defaults to keyless Open-Meteo real-time API)
OPENWEATHER_API_KEY=""

# Optional: OpenRouteService API key (system defaults to keyless OSRM + Google Routes API)
OPENROUTESERVICE_API_KEY=""

# Runtime URL injected by AI Studio / Cloud Run
APP_URL="http://localhost:3000"

# Environment & Logging
APP_ENV="development"
LOG_LEVEL="info"
CORS_ORIGINS="*"

# --- CLIENT-SIDE PUBLIC VARIABLES (VITE_ PREFIX) ---

# Google Maps Platform JavaScript API Key (restrict by HTTP referrer & APIs in GCP Console)
# Provisioned automatically in AI Studio via Google Maps Platform setup
VITE_GOOGLE_MAPS_API_KEY=""

# Optional: Custom API base URL if deploying frontend separately (defaults to same origin)
VITE_API_BASE_URL=""

# Optional: Override Firebase project on external deployments (e.g. Vercel)
# Leave blank in AI Studio to use firebase-applet-config.json automatically
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

